<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kanjian" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#1B5E20</item>
        <item name="colorPrimaryDark">#0B3D12</item>
        <item name="colorAccent">#2E7D32</item>
        <item name="android:windowBackground">#121212</item>
    </style>

    <!-- 大字号、高对比：目标用户是视障者，界面首先服务于可读性与可触达 -->
    <style name="Kanjian.Button" parent="Widget.AppCompat.Button">
        <item name="android:textSize">22sp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Kanjian.Status" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
