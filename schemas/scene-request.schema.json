{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Anguis-L/kanjian/schemas/scene-request.schema.json",
  "title": "SceneRequest metadata",
  "description": "Kanjian 场景描述请求的元数据部分。图像作为 multipart 二进制部分传输，不在本 JSON 内。禁止包含 GPS、通讯录、用户姓名、设备广告标识或历史图像。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "session_id",
    "frame_timestamp_ms",
    "origin",
    "mode",
    "locale",
    "max_speech_chars",
    "policy_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "session_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "随机、可重置。端侧只接受当前活动 session 且未过期的结果。"
    },
    "frame_timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "origin": {
      "type": "string",
      "enum": ["USER", "AUTO"]
    },
    "mode": {
      "type": "string",
      "enum": ["ASK", "OCR", "AUTO"]
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "max_speech_chars": {
      "type": "integer",
      "minimum": 20,
      "maximum": 80,
      "description": "由端侧配置注入（FR-CFG-001），40 仅为默认值。网关只做范围校验，不得改写成固定值。"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "query": {
      "type": "string",
      "maxLength": 200,
      "description": "用户主动询问的原话；自动模式可省略。"
    }
  }
}
